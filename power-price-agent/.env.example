# ===== LLM（对话/解释用，不负责数值预测）=====
# 任意 OpenAI 兼容服务：OpenAI / DeepSeek / 通义 / 本地 vLLM
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=openai:gpt-5
AGENT_SUMMARY_MODEL=openai:gpt-5-nano

# ===== 市场 =====
# DE-LU / FR / NL / BE / AT / ES / PT / IT-NORD / NO1..NO5 / SE1..SE4 / DK1 / DK2 / FI / PL / CZ / HU
DEFAULT_ZONE=DE-LU

# ===== 数据源（免费，无需 key）=====
ENERGY_CHARTS_BASE=https://api.energy-charts.info
OPEN_METEO_BASE=https://api.open-meteo.com

# 可选：ENTSO-E 负荷/风光预测（免费注册：https://transparency.entsoe.eu/）
ENTSOE_API_KEY=
ENTSOE_BASE=https://web-api.tp.entsoe.eu/api

# ===== 外部预测模型 =====
# nixtla = TimeGPT（推荐，30 天免费试用：https://www.nixtla.io/）
# custom = 你自建的 Python FastAPI（POST {MODEL_URL}/predict）
# local  = 离线季节性基线（兜底）
FORECAST_PROVIDER=nixtla
NIXTLA_API_KEY=
NIXTLA_BASE=https://api.nixtla.io
NIXTLA_MODEL=timegpt-1
MODEL_TIMEOUT_MS=60000

# custom provider 时才需要
MODEL_URL=
MODEL_TOKEN=

# ===== OpenAI 兼容桥（给 go-stock 调用）=====
BRIDGE_PORT=3001
# 可选：设置后调用方必须带 Authorization: Bearer <BRIDGE_TOKEN>
BRIDGE_TOKEN=

# ===== SSE 服务 =====
PORT=3000

# ===== 可观测 =====
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=power-price-agent